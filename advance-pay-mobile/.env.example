# Advance Pay Owner Mobile Environment Configuration

# Backend API Base URL
# Local Development (iOS Simulator): http://localhost:5001
# Local Development (Android Emulator): http://10.0.2.2:5001
# Local Development (Physical Device): http://<YOUR_LOCAL_IP>:5001
# Production (Railway/Cloud backend): https://<your-backend-domain>
EXPO_PUBLIC_API_URL=http://localhost:5001

# App Environment (development, preview, production)
EXPO_PUBLIC_APP_ENV=development

